# Copy this file to ~/.trading-bot.env, fill it in, then lock it down:
#     cp scripts/phone.env.example ~/.trading-bot.env
#     chmod 600 ~/.trading-bot.env
# Never commit the filled-in file.

# Sign-in for the web console. Choose your own; ADMIN_PASS needs 10+ characters.
ADMIN_USER=you@example.com
ADMIN_PASS=change-this-to-a-long-password

# Encrypts your Bybit API keys and Telegram token before they are saved.
# 12+ characters. If you lose it, you only have to re-enter the keys.
# Do not reuse your sign-in password. Leave it empty to keep keys in memory only.
STATE_ENCRYPTION_KEY=change-this-to-another-long-passphrase

# Live trading never restarts by itself after a restart unless you set this to 1.
# Recommended: leave it at 0 until the engine checks Bybit for open positions on startup.
AUTO_RESUME_LIVE=0

# Optional: where the state file lives. Default is ~/trading-bot-state
# (private storage of the terminal app, which survives restarts).
# BOT_STATE_DIR=$HOME/trading-bot-state

# Optional: a second place for backup copies, so the state survives if the terminal
# app's own data is ever cleared. On Termux, run `termux-setup-storage` once, then
# something like: BOT_BACKUP_DIR=$HOME/storage/shared/trading-bot-backup
# BOT_BACKUP_DIR=
# BOT_BACKUP_EVERY_SEC=3600
# BOT_BACKUP_KEEP=24

# Optional: 127.0.0.1 = only this device (default). 0.0.0.0 = other devices on your
# Wi-Fi can open the page too (plain HTTP, so only on a network you trust).
# BOT_HOST=127.0.0.1
# PORT=8080

# Optional: remote dashboard and cloud backup through Supabase (see HANDOFF.md section 5b).
# Use the project's SECRET key here; keep it out of the repo and out of screenshots.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...
# Also copy the (already encrypted) API keys to Supabase. Default 0 = keys stay on the phone.
# SUPABASE_SYNC_SECRETS=0

# Optional: seconds to wait for Bybit / Supabase replies before giving up (default 20, min 5).
# Raise it if you see "ReadTimeout" errors on a slow connection.
# BOT_HTTP_TIMEOUT=20
